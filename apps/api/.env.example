# Copy this to .env (which is gitignored) and fill in actual secrets.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres — matches docker-compose.yml service "db"
DATABASE_URL=postgresql://sarsync:sarsync_dev@localhost:5433/sarsync?schema=public

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web origin (for CORS)
WEB_ORIGIN=http://localhost:5173

# OAuth (later)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email — local dev: catch-all to console; prod: AWS SES
# AWS_REGION=
# SES_FROM_EMAIL=no-reply@sarsync.com

# S3 (later)
# AWS_S3_BUCKET=
