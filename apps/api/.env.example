# Copy this to .env (which is gitignored) and fill in actual secrets.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres — matches docker-compose.yml service "db"
DATABASE_URL=postgresql://sarsync:sarsync_dev@localhost:5433/sarsync?schema=public

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web origin (for CORS)
WEB_ORIGIN=http://localhost:5173

# Comma-separated list of emails to auto-promote to platform-level admin.
# Emails in this list get isSystemAdmin=true on next signin/signup. Editing
# this list takes effect immediately for users who sign in afterwards.
SYSTEM_ADMIN_EMAILS=

# OAuth (later)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (SendGrid) — when unset, auth flows just log the link to the
# server console (perfect for local dev). Set for production:
#   1. Create a Restricted-Access key in SendGrid (Mail Send only)
#   2. Verify the sender email or domain in SendGrid
#   3. Paste the key below
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sarsync.com
SENDGRID_FROM_NAME=SarSync

# AWS S3 storage — when AWS_S3_BUCKET is set, every new upload (card
# attachments, media library, chat files) is written to S3 instead of
# local disk. Credentials read from env (or IAM role on EC2 — preferred).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 (later)
# AWS_S3_BUCKET=
